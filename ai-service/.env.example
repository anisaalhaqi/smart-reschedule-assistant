# Model intent: tfidf (baseline, default) atau indobert
INTENT_MODEL_TYPE=tfidf
INTENT_MODEL_PATH=models/intent_tfidf_lr.joblib
CONFIDENCE_THRESHOLD=0.6

# Gemini (kosongkan untuk mode template saja)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1

# Jam operasional gym (memotong rentang pagi/siang/sore/malam)
GYM_OPEN_TIME=06:00
GYM_CLOSE_TIME=21:00

# Jika diisi, Backend wajib mengirim header X-API-Key dengan nilai ini
AI_SERVICE_API_KEY=
